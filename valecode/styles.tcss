Screen {
    background: #0A0A0A;
    color: #EEEEEE;
}

/* --- Brand header -------------------------------------------------- */

#title-bar {
    dock: top;
    width: 100%;
    height: 4;
    padding: 0 3;
    background: #0A0A0A;
    border-bottom: solid #282828;
    content-align: left middle;
    overflow: hidden;
}

/* --- Provider selection ------------------------------------------- */

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
    background: #0A0A0A;
}

#select-label {
    width: 100%;
    height: auto;
    margin-top: 2;
    color: #EEEEEE;
    text-align: center;
    text-style: bold;
}

#provider-list {
    width: 64;
    height: auto;
    max-height: 16;
    margin: 1 2;
    padding: 0 1;
    background: #141414;
    border: tall #323232;
}

#provider-list:focus {
    border: tall #FAB283;
}

/* --- Conversation ------------------------------------------------- */

#chat-area {
    height: 1fr;
    min-height: 16;
    padding: 1 3 2 3;
    background: #0A0A0A;
    scrollbar-size: 1 1;
    scrollbar-color: #484848;
    scrollbar-color-hover: #606060;
    scrollbar-background: #0A0A0A;
}

.message {
    width: 100%;
    height: auto;
}

.user-row {
    width: 100%;
    height: auto;
    margin: 1 0;
}

.user-message {
    width: 100%;
    padding: 0 1;
    color: #EEEEEE;
    background: #1E1E1E;
    border-left: thick #FAB283;
}

.ai-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.assistant-label {
    height: 1;
    padding: 0 1;
    color: #FAB283;
}

.ai-message {
    width: 100%;
    padding: 0 2 0 3;
    color: #EEEEEE;
    background: transparent;
}

.error-message {
    margin: 1 2;
    padding: 0 1;
    color: #E06C75;
    background: #1B1113;
    border-left: thick #E06C75;
}

.system-message {
    margin: 0 2;
    padding: 0 1;
    color: #808080;
    border-left: thick #282828;
}

/* --- Tool calls --------------------------------------------------- */

.tool-block {
    width: auto;
    height: auto;
    margin: 0 2 0 3;
    padding: 0 1;
    color: #D8D8D8;
    background: #141414;
    border-left: thick #323232;
}

.tool-block:hover,
.tool-block:focus {
    background: #1E1E1E;
    border-left: thick #606060;
}

.tool-block-loading {
    color: #E5C07B;
    border-left: thick #E5C07B;
}

.tool-block-error {
    color: #E06C75;
    background: #1B1113;
    border-left: thick #E06C75;
}

.tool-group-summary {
    color: #7FD88F;
    border-left: thick #7FD88F;
}

.subagent-block {
    color: #D8D8D8;
    border-left: thick #5C9CF5;
}

/* --- Thinking and team progress ---------------------------------- */

#spinner-live {
    height: 1;
    margin: 0 2;
    padding: 0 1;
    color: #FAB283;
}

.thinking-done {
    margin: 0 2;
    padding: 0 1;
    color: #808080;
    text-style: italic;
}

#teammate-tree {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    color: #A8A8A8;
}

/* --- Composer ----------------------------------------------------- */

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 1 2 0 2;
    background: #0A0A0A;
    border-top: solid #282828;
}

#chat-input {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 11;
    padding: 0 1;
    color: #EEEEEE;
    background: #141414;
    border: tall #323232;
}

#chat-input:focus {
    background: #141414;
    border: tall #FAB283;
}

#chat-input:disabled {
    color: #606060;
    border: tall #282828;
}

#status-bar {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: #0A0A0A;
}

#mode-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: #A8A8A8;
}

#teammates-label {
    width: auto;
    height: 1;
    padding: 0 1;
}

#shortcut-label {
    width: 1fr;
    height: 1;
    color: #606060;
    text-align: center;
}

#model-label {
    width: auto;
    height: 1;
    padding: 0 0 0 1;
    color: #A8A8A8;
    text-align: right;
}

CompletionPopup {
    height: auto;
    max-height: 8;
    margin: 0 1;
    padding: 0 1;
    color: #D8D8D8;
    background: #1E1E1E;
    border: tall #484848;
}

/* --- Dialogs ------------------------------------------------------ */

PlanApprovalDialog,
AskUserDialog {
    align: center middle;
    background: #0A0A0A 70%;
}

#plan-dialog,
#askuser-dialog {
    width: 68;
    height: auto;
    max-height: 22;
    padding: 1 2;
    color: #EEEEEE;
    background: #141414;
    border: tall #FAB283;
}

#plan-title,
#askuser-title {
    padding: 0 0 1 0;
    color: #FAB283;
    text-align: center;
    text-style: bold;
}

#plan-dialog Button {
    width: 100%;
    margin: 0 0 1 0;
}

#askuser-options {
    height: auto;
    max-height: 12;
}

/* --- Inline interaction widgets --------------------------------- */

#perm-inline,
#plan-inline,
#askuser-inline,
#resume-inline {
    height: auto;
    margin: 1 2;
    padding: 1;
    background: #141414;
    border-left: thick #FAB283;
}

#perm-content,
#plan-content,
#askuser-content,
#resume-content {
    padding: 0;
}
