# Single-provider configuration. Copy this file to .env and fill in the values.
VALECODE_PROVIDER_NAME=anthropic-official
VALECODE_PROTOCOL=anthropic
VALECODE_BASE_URL=https://api.anthropic.com
VALECODE_MODEL=claude-sonnet-4-20250514

# Prefer the protocol-specific variable. Do not commit real API keys.
ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here
# VALECODE_API_KEY=your-api-key-here

VALECODE_THINKING=true
# VALECODE_CONTEXT_WINDOW=200000
# VALECODE_MAX_OUTPUT_TOKENS=8192
# VALECODE_PERMISSION_MODE=default

# Provider retry and repeated tool-call loop guard.
# VALECODE_LLM_MAX_RETRIES=3
# VALECODE_LLM_RETRY_BASE_DELAY=0.5
# VALECODE_LLM_RETRY_MAX_DELAY=30
# VALECODE_LLM_RETRY_MAX_WAIT=60
# VALECODE_LLM_RETRY_JITTER=0.2
# VALECODE_LOOP_REPEAT_LIMIT=3

# Shared runtime capacity, timeout, and cancellation policy.
# VALECODE_MAX_CONCURRENT_TOOLS=8
# VALECODE_LLM_TIMEOUT=300
# VALECODE_TOOL_TIMEOUT=120
# Set to 0 to wait indefinitely for interactive permission responses.
# VALECODE_PERMISSION_TIMEOUT=0

# Optional OpenTelemetry tracing (console, file, or otlp).
VALECODE_OTEL_ENABLED=false
VALECODE_OTEL_EXPORTER=file
VALECODE_OTEL_FILE=.valecode/traces.jsonl
# VALECODE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
VALECODE_OTEL_SERVICE_NAME=valecode
# Prompt, tool arguments, and outputs are redacted unless explicitly enabled.
VALECODE_OTEL_CAPTURE_CONTENT=false
